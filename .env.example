# Copier vers .env à la racine du dépôt (jamais committer .env) :
#   cp .env.example .env
#   nano .env
#
# Puis :
#   sudo sh go-vps.sh
# ou systemd : EnvironmentFile=/opt/waze-ios6/.env

WAZE_MODE=vps
WAZE_SERVER_IP=CHANGE_ME_PUBLIC_IP
SKIP_DNS=1
SKIP_DNAT=1
SKIP_TCPDUMP=1
CATCHER_HTTP_PORT=80
CATCHER_HTTPS_PORT=443
