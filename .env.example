# Copier : cp .env.example .env puis éditer WAZE_SERVER_IP.
#
# Évite :80/:443 (Apache) et :8080 (souvent Node). Défaut suggéré : 9080/9443.
# Rebuild le .deb avec le même port :
#   sh tweak/build-deb.sh TON_IP:9080

WAZE_MODE=vps
WAZE_SERVER_IP=CHANGE_ME_PUBLIC_IP
SKIP_DNS=1
SKIP_DNAT=1
SKIP_TCPDUMP=1
CATCHER_HTTP_PORT=9080
CATCHER_HTTPS_PORT=9443
