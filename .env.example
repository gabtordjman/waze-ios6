# Copier : cp .env.example .env puis éditer WAZE_SERVER_IP.
#
# Si Apache occupe déjà :80/:443, utilise des ports libres (ex. 8080/8443)
# et rebuild le .deb avec IP:port :
#   sh tweak/build-deb.sh TON_IP:8080

WAZE_MODE=vps
WAZE_SERVER_IP=CHANGE_ME_PUBLIC_IP
SKIP_DNS=1
SKIP_DNAT=1
SKIP_TCPDUMP=1
CATCHER_HTTP_PORT=8080
CATCHER_HTTPS_PORT=8443
